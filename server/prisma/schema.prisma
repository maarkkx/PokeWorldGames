generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  ACTIVE
  WON
  LOST
  ABANDONED
}

//------------------------
//-------- Tablas --------
//------------------------

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  password     String? // Hasheada; null para usuarios solo-Google
  googleId     String? @unique @map("google_id")
  authProvider String  @default("local") @map("auth_provider") // "local" | "google"
  level        Int     @default(1)
  xp           Int     @default(0)
  lootboxes    Int     @default(0)
  admin        Boolean @default(false)
  refreshToken String? @map("refresh_token") //para el jwt
  profilePokemonId Int    @default(1) @map("profile_pokemon_id") // PokeAPI official-artwork id 1–151
  profileBgColor   String @default("#F1F1F1") @map("profile_bg_color")
  sentTrades     Trade[] @relation("TradeFromUser")
  receivedTrades Trade[] @relation("TradeToUser")
  sentFriendships     Friendship[] @relation("FriendshipFrom")
  receivedFriendships Friendship[] @relation("FriendshipTo")

  // relacion n:m con pokemon
  pokemons UserPokemon[]

  pinnedPokemons UserPinnedPokemon[]

  // partidas
  guessPokemonGames   GuessPokemonGame[]
  guessShinyGames     GuessShinyGame[]
  pokedokuGames       PokedokuGame[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Pokemon {
  id            Int     @id @default(autoincrement())
  name          String
  generation    Int
  urlImage      String? @map("url_image")
  urlShinyImage String? @map("url_shiny_image")
  legendary     Boolean @default(false)
  myth          Boolean @default(false)
  hp            Int
  atk           Int
  def           Int
  spAtk         Int     @map("spatk")
  spDef         Int     @map("spdef")
  speed         Int

  // n:m con User
  owners UserPokemon[]

  // n:m con Type
  types PokemonType[]

  // Auto relacion
  evolutionsFrom EvolutiveChain[] @relation("EvolutionFrom")
  evolutionsTo   EvolutiveChain[] @relation("EvolutionTo")

  // partidas
  guessPokemonGames   GuessPokemonGame[]
  guessShinyGames     GuessShinyGame[]
  pokedokuAnswerCells PokedokuGameCell[]

  //trades
  tradeItems TradeItem[]

  pinnedByUsers UserPinnedPokemon[]

  @@map("pokemon")
}

model Type {
  id      Int    @id @default(autoincrement())
  name    String @unique
  Pokemon PokemonType[]

  @@map("types")
}

//------------------------
// Tablas Relaciones N:M -
//------------------------

model UserPokemon {
  userId    Int @map("id_user")
  pokemonId Int @map("id_pokemon")
  quantity  Int @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@id([userId, pokemonId])
  @@map("user_pokemon")
}

model UserPinnedPokemon {
  userId    Int @map("id_user")
  slot      Int // 1 | 2 | 3 | 4
  pokemonId Int @map("id_pokemon")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@id([userId, slot])
  @@map("user_pinned_pokemon")
}

model PokemonType {
  pokemonId Int @map("id_pokemon")
  typeId    Int @map("id_type")

  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  type    Type    @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@id([pokemonId, typeId])
  @@map("pokemon_type")
}

model EvolutiveChain {
  evolutionChainId Int    @map("id_evolution_chain")
  fromPokemonId    Int    @map("from_pokemon_id")
  toPokemonId      Int    @map("to_pokemon_id")
  method           String?
  condition        String?

  fromPokemon Pokemon @relation("EvolutionFrom", fields: [fromPokemonId], references: [id], onDelete: Cascade)
  toPokemon   Pokemon @relation("EvolutionTo", fields: [toPokemonId], references: [id], onDelete: Cascade)

  @@id([evolutionChainId, fromPokemonId, toPokemonId])
  @@map("evolutive_chain")
}

//------------------------
//------ Guess Game ------
//------------------------

model GuessPokemonGame {
  id                Int        @id @default(autoincrement())
  gameId            String     @unique @default(cuid()) @map("id_game")
  userId            Int        @map("id_user")
  pokemonId         Int        @map("id_pokemon") //Respuesta correcta
  maxAttempts       Int        @default(3) @map("max_attempts") //las vidas maximas
  remainingAttempts Int        @default(3) @map("remaining_attempts") //vidas restantes
  lastGuess         String?    @map("last_guess") //ultimo try que ha hecho el usuario
  status            GameStatus @default(ACTIVE)
  startedAt         DateTime   @default(now()) @map("started_at")
  xpEarned          Int?       @map("xp_earned")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("guess_pokemon_games")
}

model GuessShinyGame {
  id                Int        @id @default(autoincrement())
  gameId            String     @unique @default(cuid()) @map("id_game")
  userId            Int        @map("id_user")
  pokemonId         Int        @map("id_pokemon")
  correctPosition   Int        @default(1) //saber en que posicion va a estar la forma original
  maxAttempts       Int        @default(3) @map("max_attempts")
  remainingAttempts Int        @default(3) @map("remaining_attempts")
  lastGuess         String?    @map("last_guess")
  status            GameStatus @default(ACTIVE)
  startedAt         DateTime   @default(now()) @map("started_at")
  xpEarned          Int?       @map("xp_earned")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("guess_shiny_games")
}

//------------------------
//-------- Pokedoku ------
//------------------------

// Tengo una tabla donde guardo al id del juego que tiene una relacion con otra tabla
// que guarda las 9 condiciones de cada partida
// por lo tanto se harian 9 relaciones por cada partida

model PokedokuGame {
  id        Int        @id @default(autoincrement())
  gameId    String     @unique @default(cuid()) @map("id_game")
  userId    Int        @map("id_user")
  status    GameStatus @default(ACTIVE)
  startedAt DateTime   @default(now()) @map("started_at")
  xpEarned  Int?       @map("xp_earned")

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cells PokedokuGameCell[]

  @@index([userId, status])
  @@map("pokedoku_games")
}

model PokedokuGameCell {
  id                   Int       @id @default(autoincrement())
  gameInternalId       Int       @map("id_game")
  position             Int
  rowConditionType     String    @map("row_condition_type")
  rowConditionValue    String    @map("row_condition_value")
  columnConditionType  String    @map("column_condition_type")
  columnConditionValue String    @map("column_condition_value")
  answerPokemonId      Int?      @map("answer_pokemon_id")
  isCorrect            Boolean?  @map("is_correct")
  answeredAt           DateTime? @map("answered_at")

  game          PokedokuGame @relation(fields: [gameInternalId], references: [id], onDelete: Cascade)
  answerPokemon Pokemon?     @relation(fields: [answerPokemonId], references: [id], onDelete: SetNull)

  @@unique([gameInternalId, position])
  @@map("pokedoku_game_cells")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("id_user")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Trade {
  id         Int         @id @default(autoincrement())
  tradeId    String      @unique @default(cuid()) @map("id_trade")
  fromUserId Int         @map("from_user_id")
  toUserId   Int         @map("to_user_id")
  status     TradeStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  fromUser   User        @relation("TradeFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User        @relation("TradeToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  items      TradeItem[]

  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@map("trades")
}

model TradeItem {
  id          Int   @id @default(autoincrement())
  tradeIdFk   Int   @map("id_trade_fk")
  ownerUserId Int   @map("owner_user_id")
  pokemonId   Int   @map("id_pokemon")
  quantity    Int

  trade       Trade   @relation(fields: [tradeIdFk], references: [id], onDelete: Cascade)
  pokemon     Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Restrict)

  @@map("trade_items")
}

model Friendship {
  id         Int              @id @default(autoincrement())
  fromUserId Int              @map("from_user_id")
  toUserId   Int              @map("to_user_id")
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  fromUser User @relation("FriendshipFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendshipTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("friendships")
}